{
  "name": "@zhang-guo-wen/dsh-command-btw",
  "description": "Human-facing /btw command: forks a continuable child subagent to answer a side question",
  "version": "0.1.3-alpha.2",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-subagent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {}
}
